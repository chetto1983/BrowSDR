[Unit]
Description=rtl_tcp relay: one dongle, many clients (WebSocket + rtl_tcp on the PC link)
After=network-online.target rtl-tcp.service
Wants=network-online.target rtl-tcp.service

[Service]
User=pi
ExecStart=/usr/local/bin/rtl-relay -upstream 127.0.0.1:1234 -tcp 192.168.250.2:1234 -http 192.168.250.2:8765
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
